# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASS=a Google app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Orbit
