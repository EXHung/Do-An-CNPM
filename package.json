{
  "name": "orbit-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev apps/web",
    "dev:sp1": "node scripts/dev-sp1.mjs",
    "db:local": "node scripts/local-db.mjs",
    "api:types": "openapi-typescript packages/contracts/openapi.yaml -o packages/contracts/api.generated.ts",
    "build": "next build apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/api/src apps/web/app apps/web/components apps/web/lib packages/contracts/domain.ts tests/domain.test.ts tests/e2e --max-warnings=0",
    "test": "node scripts/run-unit-tests.mjs",
    "test:policy": "node scripts/run-policy-tests.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/sp1.integration.cjs",
    "test:e2e": "playwright test",
    "api:dev": "ts-node --project apps/api/tsconfig.json apps/api/src/main.ts",
    "api:build": "tsc --project apps/api/tsconfig.json",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "^2.49.0",
    "lucide-react": "0.468.0",
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@nestjs/testing": "^11.2.8",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.27",
    "openapi-typescript": "^7.13.0",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
